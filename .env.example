# Copia este archivo como .env y ajusta los valores
PORT=3000

# Base de datos (docker compose usa estas variables)
POSTGRES_VERSION=18-alpine
POSTGRES_CONTAINER_NAME=postgres-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydatabase
POSTGRES_PORT=5433
DB_HOST=localhost
DB_TYPE=postgres
DB_SYNCHRONIZE=true

# Seguridad
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=1h
SALT_ROUNDS=10
